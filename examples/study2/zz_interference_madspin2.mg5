set automatic_html_opening False --no_save
set notification_center False --no_save
set zerowidth_tchannel False --no_save
set nb_core 12 --no_save
set nb_core_pythia8 12 --no_save
set nb_core_delphes 12 --no_save
import model sm-full
define p = g u c d s b u~ c~ d~ s~ b~
define l+ = e+ mu+
define l- = e- mu-
# Unpolarised production. The interference between two polarisation states
# only exists in a sample that contains both of them, so no braces here.
generate p p > z z
output zz_interference_madspin2 -f
display diagrams ./diagrams/zz_interference_madspin2 --no_open --merge
launch zz_interference_madspin2 --name=test1
madspin = ON
shower = OFF
detector = OFF
analysis = OFF
done
set ebeam 6800
# ../cards/pythia8_card_TuneA14_noMPI.dat
# ../cards/delphes_card_ATLAS_FatJetPTMin50.tcl
set spinmode full
add madspin_card --before_line="launch" set pure_interference z = 0 T
add madspin_card --before_line="launch" set pure_interference_full True
decay z > l+ l-
set pdlabel lhapdf
set lhaid 331900 # NNPDF40_lo_as_01180
set use_syst True
set systematics_program systematics
set systematics_arguments ['--together=mur,muf,dyn', '--pdf=errorset']
set nevents 1000
done
