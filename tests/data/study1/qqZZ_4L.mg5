set automatic_html_opening False --no_save
set notification_center False --no_save
set zerowidth_tchannel False --no_save
set nb_core 12 --no_save
set nb_core_pythia8 12 --no_save
set nb_core_delphes 12 --no_save
import model sm-full
define p = g u c d s b u~ c~ d~ s~ b~
define j = g u c d s b u~ c~ d~ s~ b~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm
define vl~ = ve~ vm~
generate p p > l+ l- l+ l- / h QED=4 QCD=0
output qqZZ_4L -f
display diagrams ./diagrams/qqZZ_4L --no_open --merge
launch qqZZ_4L --name=test1
shower = Pythia8
detector = Delphes
analysis = OFF
done
set ebeam 6800
../cards/pythia8_card_TuneA14_noMPI.dat
../cards/delphes_card_ATLAS_FatJetPTMin50.tcl
set pdlabel lhapdf
set lhaid 331900 # NNPDF40_lo_as_01180
set use_syst True
set systematics_program systematics
set systematics_arguments ['--together=mur,muf,dyn', '--pdf=errorset']
set nevents 1000
done